{
  "expo": {
    "name": "GymFuel",
    "slug": "gymfuel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymfuel",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymfuel.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GymFuel needs camera access to scan food and receipts",
        "NSPhotoLibraryUsageDescription": "GymFuel needs photo library access to select food images"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a1a0f"
      },
      "package": "com.gymfuel.app",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "GymFuel needs camera access to scan food items"
        }
      ],
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
